# Site URL
NEXT_PUBLIC_SITE_URL=https://launchpath.co.za

# Recipient Email Addresses (Defaults to hello@launchpath.co.za if left empty)
NOTIFICATION_EMAIL=hello@launchpath.co.za
FOUNDER_APPLICATION_EMAIL=hello@launchpath.co.za
SPONSOR_ENQUIRY_EMAIL=hello@launchpath.co.za
GENERAL_CONTACT_EMAIL=hello@launchpath.co.za

# Email Provider Option 1: Resend (Recommended for Next.js)
RESEND_API_KEY=
RESEND_FROM=LaunchPath Labs <hello@launchpath.co.za>

# Email Provider Option 2: SMTP (Any mail server, e.g. Google Workspace, Office 365, cPanel, SES)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LaunchPath Labs" <hello@launchpath.co.za>

# Email Provider Option 3: Webhook (Zapier, Make, custom webhook or Slack)
SUBMISSION_WEBHOOK_URL=
SUBMISSION_WEBHOOK_SECRET=
