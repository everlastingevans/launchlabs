# Site URL
NEXT_PUBLIC_SITE_URL=https://launchpath.co.za

# PostgreSQL Database & Prisma ORM (Powered by Neon on Vercel)
# Standard Neon connection string: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL=
DIRECT_URL=
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Admin API / Dashboard Protection (Optional)
ADMIN_SECRET_KEY=

# (Optional / Legacy) Email Notification Settings
NOTIFICATION_EMAIL=hello@launchpath.co.za
FOUNDER_APPLICATION_EMAIL=hello@launchpath.co.za
SPONSOR_ENQUIRY_EMAIL=hello@launchpath.co.za
GENERAL_CONTACT_EMAIL=hello@launchpath.co.za

# Optional Email Providers if notifications are needed alongside database storage:
RESEND_API_KEY=
RESEND_FROM=LaunchPath Labs <hello@launchpath.co.za>

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LaunchPath Labs" <hello@launchpath.co.za>
